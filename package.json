{
  "name": "sonara",
  "private": true,
  "version": "0.1.0",
  "description": "Sonara — Next Level Piano Mastery",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @sonara/shared",
    "dev": "npm run build:shared && node scripts/dev.mjs",
    "dev:api": "npm run dev -w @sonara/api",
    "dev:web": "npm run dev -w @sonara/web",
    "build": "npm run build:shared && npm run build -w @sonara/api && npm run build -w @sonara/web",
    "start": "npm run start -w @sonara/api",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "verify:audio": "node scripts/verify-audio.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}

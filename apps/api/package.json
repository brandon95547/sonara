    "@sonara/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }

# Sonara API — copy to .env for local overrides. Every value here is the default.

# Port the HTTP server binds to.
PORT=5175

# Interface to bind. 0.0.0.0 exposes the API to your LAN, which is what you want
# when testing the app on a phone or tablet against a dev machine.
HOST=0.0.0.0

# development | test | production
NODE_ENV=development

# SQLite file. Relative paths resolve against the api workspace root.
DATABASE_PATH=./data/sonara.sqlite

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

 error | error | warn | info | debug | trace
LOG_LEVEL=info
